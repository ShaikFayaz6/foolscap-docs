# Copy to .env for local use. Every value is optional; these are the defaults.
# Hosted deployments set these as environment variables or secrets instead.

PORT=3000
# DATABASE_PATH=./data/foolscap.db
LOG_LEVEL=info

# Number of reverse proxies in front of the app. 0 locally; the Docker image sets 1.
TRUST_PROXY=0

# Demo accounts are created only when the database is first created.
# Changing DEMO_PASSWORD later does not change existing accounts.
SEED_DEMO_ACCOUNTS=true
DEMO_PASSWORD=foolscap-demo

{
  "name": "foolscap",
  "version": "1.0.0",
  "private": true,
  "description": "A small full-stack document editor with sharing and file import.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "lint": "biome lint client server shared e2e",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.ts\"",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/html": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "happy-dom": "^21.0.4",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
